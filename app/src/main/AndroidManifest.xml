        <!-- ============================================================ -->
        <!-- Quick Settings Tile                                          -->
        <!-- ============================================================ -->
        <service
            android:name=".widget.QuickConnectTile"
            android:exported="true"
            android:icon="@drawable/ic_terminal"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- ============================================================ -->
        <!-- Foreground Service for SSH connections                        -->
        <!--                                                                -->
        <!-- Type: specialUse (NOT dataSync). dataSync has a 6-hour daily   -->
        <!-- limit on Android 14+ which would silently kill an SSH client   -->
        <!-- that's expected to stay connected all day. specialUse is the   -->
        <!-- correct type for "persistent network connection that doesn't   -->
        <!-- fit any other category" — same approach as Termux, ConnectBot. -->
        <!-- ============================================================ -->
        <service
            android:name=".service.SshForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains persistent SSH connections to remote servers." />
        </service>

        <!-- ============================================================ -->
        <!-- Boot Receiver for auto-connect servers                       -->
        <!-- ============================================================ -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
